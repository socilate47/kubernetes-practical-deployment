# Copy to .env (git-ignored) and fill in before running `make secrets`.
# Values flow into Kubernetes Secrets `biasharaos-s3` and
# `biasharaos-invoice-token`, which the Deployment envFrom's.

# ---- MinIO / S3 (biasharaos-s3) -------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_ENDPOINT=http://192.168.30.147:9000
S3_BUCKET=biasharaos-uploads
S3_FORCE_PATH_STYLE=true

# ---- Invoice upload auth (biasharaos-invoice-token) -----------------------
# Leave empty to let create-secrets.sh generate a fresh hex-32 for you.
INVOICE_UPLOAD_TOKEN=
